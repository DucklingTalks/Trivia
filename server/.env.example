# Backend runtime configuration.
# Copy this file to the local environment mechanism used by the server.
# Do not commit the populated file.

# Sentry backend DSN from the trivia-server Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Optional release identifier, normally generated by CI/CD.
# Examples: trivia-server-local, trivia-server-staging-2026.09.10
SENTRY_RELEASE=

# Fraction of performance traces sent to Sentry.
# Allowed range: 0 to 1.
# 0   = no performance traces recorded.
# 0.1 = approximately 10% of traces.
# 1   = 100% of traces; useful for short debugging periods, not usually production.
# Empty/unset = performance tracing disabled unless code configures another sampler.
SENTRY_TRACES_SAMPLE_RATE=0
