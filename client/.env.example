# Public frontend configuration.
# Copy this file to .env.local for local development.
# Never place administrative tokens or private credentials in VITE_* variables.

# PostHog project ingestion key and regional host.
# Obtain both values from the PostHog project selected for this environment.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Sentry frontend DSN. It is an ingestion value and is visible in the browser bundle.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local

# Optional release identifier, normally generated by CI/CD.
# Examples: trivia-client-local, trivia-client-staging-2026.09.10
VITE_SENTRY_RELEASE=

# Privacy-first default: PostHog waits for an explicit consent flow.
# Allowed values: true or false.
VITE_POSTHOG_CONSENT_REQUIRED=true
